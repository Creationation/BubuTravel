# Analyseur BuBuTravel : copier en .env (meme dossier) et remplir.
# Ce fichier .env ne doit JAMAIS etre commite (il est dans .gitignore).

SUPABASE_URL=https://ojffneapboofdbascqxl.supabase.co
# Supabase > Project Settings > API keys > secret (service_role). Donne tous les droits : reste sur ce PC.
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com > API keys
ANTHROPIC_API_KEY=

# console.groq.com > API keys (transcription Whisper)
GROQ_API_KEY=

# Nom de cette machine dans l'app (« PC maison », « VPS »...)
ANALYZER_NAME=PC maison
